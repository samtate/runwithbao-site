---
import Base from "../layouts/Base.astro";
import Bao from "../components/Bao.astro";
import { APP } from "../site";

/** What's free for good: the things a runner would actually miss. */
const free = [
  "Couch to 5K, start to finish",
  "Sessions sent to your Garmin watch",
  "Run tracking with your phone's GPS, or indoors on a treadmill, with voice cues (Android)",
  "Runs from Garmin, Strava, Health Connect or any watch's FIT file",
  "Move a run up to three days either way",
  "Time off for holidays and busy weeks",
  "Ill or injured? Your streak waits",
  "Make any session easier in one tap",
  "Sleep, heart rate and other sport shape the day's session",
  "Saturday parkrun planned in",
  "On Android and the web, with one account",
];

/** What Plus is for: training towards something, with a plan that knows how. */
const plus = [
  "Plans for a faster 5K, 10K, half marathon and marathon",
  "Keep building after Couch to 5K, towards 10K and beyond",
  "Built around your race day, with recovery weeks and a proper taper",
  "Intervals, tempo, hills, strides and progression runs, varied week to week",
  "Steps up when you're cruising, eases off when it's hard",
  "Expects you to get fitter, and checks with a 5K time trial every few weeks, on your parkrun if you do one",
  "Run by pace or by heart rate",
  "B races and parkruns as tune-ups, with their times setting your paces",
  "Your likely race times, updated as you train",
];

/**
 * How Bao compares, checked on 10 November 2026 from each app's own price page, UK App Store listing, support
 * docs and recent reviews. "yes", "no" and "part" draw as marks; anything else is shown as text. Where we couldn't
 * confirm a feature either way it says "–".
 */
type Cell = "yes" | "no" | "part" | string;
const apps = ["Bao", "Runna", "Coopah", "Garmin Coach"];
const compare: [string, Cell[]][] = [
  ["Price", ["Free · Plus [[plus]]",
    "£17.99/month, £109.99/year<small>If you already pay £15.99 or £99.99: from your first renewal on or after 10 Dec 2026</small>",
    "£14.99/month, £79.99/year", "Free with a Garmin"]],
  ["Free plan for beginners", ["yes", "First week only", "no", "With a Garmin"]],
  ["Plans from 5K to marathon", ["yes", "yes", "yes", "Up to half marathon"]],
  ["Move a run to another day", ["Up to 3 days, any week", "Within a week either side", "yes", "part"]],
  ["Time off without breaking the plan", ["yes", "yes", "–", "part"]],
  ["Make a session easier in one tap", ["yes", "part", "–", "–"]],
  ["Sleep and heart rate change the day", ["yes", "–", "–", "yes"]],
  ["Other sport counts towards tiredness", ["yes", "–", "–", "yes"]],
  ["Indoor and treadmill runs", ["yes", "yes", "–", "yes"]],
  ["Paces checked with a regular 5K time trial", ["yes", "Adjusts paces as you train", "–", "Adapts as you train"]],
  ["Works in a web browser", ["yes", "no", "no", "part"]],
  ["Workouts on a Garmin", ["yes", "yes", "yes", "yes"]],
  ["iPhone and Apple Watch app", ["no", "yes", "yes", "no"]],
  ["Human coaches", ["no", "–", "yes", "no"]],
];
---
<Base
  title="Pricing · Run With Bao"
  description="Most of Run With Bao is free, including Couch to 5K and your Garmin. Bao Plus adds race plans from a faster 5K to the marathon, with your first run free and a 14-day free trial on the yearly plan."
>
  <section class="wrap hero">
    <p class="label">Pricing</p>
    <h1>Most of Bao is <em>free</em>.</h1>
    <p class="lede">Couch to 5K, your watch, your runs, and everything that lets a plan fit around your week cost
      nothing. Bao Plus is for when you're training for a race.</p>
  </section>

  <section class="wrap plans">
    <div class="card plan">
      <p class="label">Free</p>
      <p class="price"><span data-price="zero">£0</span> <span>for as long as you like</span></p>
      <ul class="ticks">{free.map((what) => <li>{what}</li>)}</ul>
      <p class="small muted">No ads, and your data is never sold.</p>
    </div>
    <div class="card plan plus">
      <p class="label">Bao Plus</p>
      <p class="price"><span data-price="monthly">£5.99</span> <span>a month</span></p>
      <p class="muted">or <span data-price="yearly">£39.99</span> a year, which works out at <span data-price="perMonth">£3.33</span> a month</p>
      <p class="trial">Your first run free, then 14 days free on the yearly plan</p>
      <p class="also">Everything in Free, plus a plan for your race:</p>
      <ul class="ticks">{plus.map((what) => <li>{what}</li>)}</ul>
      <p class="small muted">Payments open soon, and until then it's all free.</p>
    </div>
  </section>

  <section class="wrap compare-block">
    <h2>How Bao <em>compares</em></h2>
    <p class="muted">Prices checked November 2026, from each app's own price page or its UK App Store listing, and
      features from their own pages, help guides and recent reviews. Prices change, so do check. If anything here is
      out of date, tell us at hello@runwithbao.app and we'll fix it.</p>
    <div class="scroll">
      <table class="compare">
        <thead><tr><th></th>{apps.map((a, i) => <th class:list={{ ours: i === 0 }}>{i === 0 ? <span class="us"><Bao mood="happy" size={28} />Bao</span> : a}</th>)}</tr></thead>
        <tbody>
          {compare.map(([what, cells]) => (
            <tr>
              <th scope="row">{what}</th>
              {cells.map((c, i) => (
                <td class:list={{ ours: i === 0 }}>
                  {c === "yes" ? <span class="mark yes" aria-label="Yes">✓</span>
                    : c === "no" ? <span class="mark no" aria-label="No">✕</span>
                    : c === "part" ? <span class="mark part" aria-label="Partly">~</span>
                    : c === "–" ? <span class="unknown" aria-label="Not that we could find">–</span>
                    : <span set:html={c.replace("[[plus]]", "<span data-price=\"monthly\">£5.99</span>/month")} />}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="key small muted"><span class="mark yes">✓</span> yes <span class="mark part">~</span> partly
      <span class="mark no">✕</span> no <span class="unknown">–</span> not that we could find</p>

    <div class="card why">
      <Bao mood="happy" size={80} live />
      <div>
        <h3>Why runners pick Bao</h3>
        <ul class="ticks">
          <li>Weeks rarely go to plan. Move a run, take time off or be ill, and the plan adjusts without losing
            your streak.</li>
          <li>On a heavy day, one tap gives you an easier session. Change your mind and put it back.</li>
          <li>Your sleep, heart rate and other sport decide how hard today should be, not only your last run.</li>
          <li>Plans expect you to get fitter, and a 5K time trial every few weeks, on your parkrun if you do one,
            keeps your paces in step with you.</li>
          <li>Winter on the treadmill? Choose indoors before a run on Android, or bring treadmill runs in from your
            watch, and they still count towards your week.</li>
          <li>Plus costs less than half as much as Runna, and your first run is free, with no card.</li>
          <li>It works in any browser, so it's there on a laptop or an iPhone as well.</li>
        </ul>
        <div class="actions">
          <a class="button" href={APP} data-app data-cta="pricing-why">Get started free</a>
          <a class="button quiet" href="/articles">Read the articles</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap faq">
    <h2>Questions about <em>paying</em></h2>
    <details><summary>How does the free trial work?</summary>
      <p>Set up a race plan and you can see its next two weeks and do your first run free, no card. After that,
        the yearly plan starts with 14 days free: you add a card, nothing is charged for 14 days, and we remind you
        by notification and email two days before. Cancel before day 14 and you pay nothing. The monthly plan has
        no trial and starts straight away.</p></details>
    <details><summary>I forgot to cancel. Can I get my money back?</summary>
      <p>Yes. Email hello@runwithbao.app within 14 days of the charge and we'll refund it in full, no questions
        asked.</p></details>
    <details><summary>What happens if I don't start a trial?</summary>
      <p>Your plan waits for you. Your runs, streak and badges stay, you can still track and bring in runs, and you
        can switch to Couch to 5K for free whenever you like.</p></details>
    <details><summary>How do I cancel?</summary>
      <p>In Google Play's subscriptions if you paid there, or in your account on the web. You keep Plus until the
        end of the period you've paid for.</p></details>
    <details><summary>Can I get a refund?</summary>
      <p>Yes. Ask within 14 days of a payment and we'll refund it. Email hello@runwithbao.app.</p></details>
    <details><summary>Where do I pay?</summary>
      <p>On Android through Google Play, or on the web. Plus then works on every device you sign in on.</p></details>
    <details><summary>Are prices in my currency?</summary>
      <p>Yes: pounds in the UK, euros in the eurozone and US dollars elsewhere. UK and EU prices include VAT; US
        prices are before any sales tax.</p></details>
  </section>
</Base>



<style>
  .hero { padding-top: clamp(2rem, 6vw, 4rem); display: grid; gap: 1rem; max-width: 46rem; }
  .plans { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: 1.25rem;
    margin-top: 2.5rem; align-items: stretch; }
  .plan { display: grid; gap: 0.6rem; align-content: start; }
  .plus { border: 2px solid var(--accent); }
  .price { font: 600 2.6rem/1 var(--serif); }
  .price > span:not([data-price]) { font: 500 1rem var(--sans); color: var(--muted); }
  .trial { font-weight: 600; color: var(--accent-strong); }
  .also { font-weight: 600; margin-top: 0.4rem; }
  .small { font-size: 0.875rem; }
  .ticks { list-style: none; padding: 0; margin: 0.4rem 0 0; display: grid; gap: 0.6rem; }
  .ticks li { position: relative; padding-left: 1.85rem; }
  .ticks li::before { content: "✓"; position: absolute; left: 0; top: 0.1rem; width: 1.25rem; height: 1.25rem;
    border-radius: 50%; background: var(--sage-soft); color: #2f5a35; font-weight: 700; font-size: 0.78rem;
    display: grid; place-items: center; }

  .compare-block { margin-top: clamp(3.5rem, 9vw, 6rem); display: grid; gap: 1rem; }
  .scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: 24px; border: 1px solid var(--border);
    background: var(--surface); }
  .compare { border-collapse: separate; border-spacing: 0; width: 100%; min-width: 46rem; font-size: 0.93rem; }
  .compare :global(small) { display: block; margin-top: 0.3rem; font-size: 0.75rem; font-weight: 400; color: var(--muted);
    line-height: 1.35; }
  .compare th, .compare td { padding: 0.85rem 0.9rem; text-align: center; vertical-align: middle;
    border-bottom: 1px solid var(--border); }
  .compare tbody tr:last-child > * { border-bottom: 0; }
  .compare thead th { font-weight: 600; font-size: 0.95rem; padding-block: 1.1rem; }
  .compare tbody th { text-align: left; font-weight: 500; min-width: 13rem; }
  .compare .ours { background: color-mix(in srgb, var(--accent) 10%, var(--surface)); font-weight: 600; }
  .compare thead .ours { border-radius: 16px 16px 0 0; }
  .us { display: inline-flex; align-items: center; gap: 0.4rem; font: 600 1.1rem var(--serif); }
  .mark { display: inline-grid; place-items: center; width: 1.7rem; height: 1.7rem; border-radius: 50%;
    font-weight: 700; font-size: 0.85rem; }
  .yes { background: var(--sage-soft); color: #2f5a35; }
  .no { background: color-mix(in srgb, var(--accent) 14%, transparent); color: var(--accent-strong); }
  .part { background: var(--butter-soft); color: #6b5310; }
  .unknown { color: var(--muted); }
  .key { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.6rem; }
  .key .mark { width: 1.3rem; height: 1.3rem; font-size: 0.7rem; }

  .why { display: flex; gap: 1.5rem; align-items: flex-start; margin-top: 1.5rem; }
  .why h3 { margin-bottom: 0.75rem; font-size: 1.75rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .faq { margin-top: clamp(3rem, 8vw, 5rem); max-width: 46rem; display: grid; gap: 0.25rem; }
  .faq h2 { margin-bottom: 1rem; }
  details { border-bottom: 1px solid var(--border); }
  summary { cursor: pointer; padding: 1.1rem 0; font-weight: 600; font-size: 1.1rem; }
  details p { padding-bottom: 1.25rem; color: var(--muted); }
  @media (max-width: 560px) { .why { flex-direction: column; } }
</style>
