---
/**
 * An article: a headline, when it was written, readable prose, and a way into the app at the end. Markdown pages
 * in src/pages/articles use it through their frontmatter, which also feeds the articles index and search engines.
 */
import Base from "./Base.astro";
import Bao from "../components/Bao.astro";
import { APP, SITE } from "../site";

const { frontmatter } = Astro.props;
const { title, description, date, heading } = frontmatter;
const url = new URL(Astro.url.pathname, SITE).toString();
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: date,
  dateModified: frontmatter.updated ?? date,
  author: { "@type": "Organization", name: "Bao Run" },
  publisher: { "@type": "Organization", name: "Bao Run", logo: `${SITE}/bao-300.png` },
  mainEntityOfPage: url,
});
const shown = new Date(date).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---
<Base title={`${title} · Bao Run`} description={description}>
  <script type="application/ld+json" set:html={schema} />
  <article class="wrap article">
    <p class="label"><a href="/articles">Articles</a> · {shown}</p>
    <h1 set:html={heading ?? title} />
    <p class="lede">{description}</p>
    <div class="prose"><slot /></div>
    <aside class="card cta">
      <Bao mood="happy" size={72} />
      <div>
        <h3>Try Bao free</h3>
        <p class="muted">Couch to 5K is free, start to finish. Plans beyond it start with two weeks free, no card
          needed.</p>
        <div class="actions">
          <a class="button" href={APP} data-app data-cta="article">Get started</a>
          <a class="button quiet" href="/pricing">See pricing</a>
        </div>
      </div>
    </aside>
  </article>
</Base>

<style>
  .article { max-width: 46rem; padding-top: clamp(1.5rem, 5vw, 3.5rem); display: grid; gap: 1.25rem; }
  .label a { color: inherit; }
  .prose { font-size: 1.075rem; line-height: 1.7; }
  .prose :global(h2) { font-size: 1.85rem; margin: 2.5rem 0 0.75rem; }
  .prose :global(h3) { font-size: 1.25rem; margin: 1.75rem 0 0.5rem; }
  .prose :global(p), .prose :global(ul), .prose :global(ol), .prose :global(table) { margin: 0 0 1.1rem; }
  .prose :global(li) { margin-bottom: 0.45rem; }
  .prose :global(table) { border-collapse: collapse; width: 100%; font-size: 0.95rem; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { text-align: left; vertical-align: top; padding: 0.55rem 0.75rem 0.55rem 0;
    border-bottom: 1px solid var(--border); }
  .cta { display: flex; gap: 1.25rem; align-items: flex-start; margin-top: 2rem; }
  .cta h3 { margin-bottom: 0.4rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1rem; }
  @media (max-width: 560px) { .cta { flex-direction: column; } }
</style>
