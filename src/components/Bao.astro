---
import posesFile from "../illustrations/bao-poses.json";
/**
 * Bao, as a still pose exported from the app's own animation (public/bao.json; scripts/bao-poses.mjs), so every page
 * ships plain SVG. [live] (or the older [wave]) plays his mood's loop from that same pose once he scrolls into view;
 * with reduced motion, or before the script loads, he simply stays as drawn.
 */
export type BaoMood = keyof typeof posesFile.poses;
interface Props {
  mood?: BaoMood;
  size?: number;
  live?: boolean;
  wave?: boolean;
  class?: string;
  label?: string;
}
const { mood = "neutral", size = 160, live = false, wave = false, class: className = "", label } = Astro.props;

const id = `b${Math.random().toString(36).slice(2, 8)}`;
const body = posesFile.poses[mood].replaceAll("BAOID_", `${id}_`);
const [clip, at] = posesFile.frames[mood];
const loop = clip === "idle" ? "idle" : clip;
---
<span
  class:list={["bao", className]}
  style={`width:${size}px;height:${size}px`}
  data-bao-live={live || wave ? JSON.stringify([loop, at]) : undefined}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  <svg viewBox="14 26 212 212" set:html={body} />
</span>

<script>
  import { bringBaoToLife } from "../scripts/bao-live";
  bringBaoToLife();
</script>

<style>
  .bao { display: inline-block; position: relative; flex: none; vertical-align: middle; }
  .bao > svg, .bao :global(.bao-live) { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .bao :global(.bao-live svg) { overflow: visible; }
  .bao:global(.live) > svg { visibility: hidden; }
</style>
