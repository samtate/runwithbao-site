---
import { baoBody, type BaoMood } from "../illustrations/bao";
/**
 * Bao, drawn at build time from the same shapes as the app's reference (docs/bao-reference.html), so the page
 * ships an inline SVG and no script. [wave] adds a gentle bob that stops for anyone who prefers less motion.
 */
interface Props {
  mood?: BaoMood;
  size?: number;
  wave?: boolean;
  class?: string;
  label?: string;
}
const { mood = "neutral", size = 160, wave = false, class: className = "", label } = Astro.props;

const body = baoBody(mood, `bao-${mood}-${Math.random().toString(36).slice(2, 8)}`);
---
<svg
  viewBox="-6 -6 212 212"
  width={size}
  height={size}
  class:list={["bao", { wave }, className]}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  set:html={body}
/>

<style>
  .bao { overflow: visible; flex: none; }
  .wave { animation: bob 3.2s ease-in-out infinite; transform-origin: 50% 90%; }
  .wave :global(.star) { animation: twinkle 2.4s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes bob {
    0%, 100% { transform: translateY(0) rotate(0); }
    50% { transform: translateY(-6px) rotate(-2deg); }
  }
  @keyframes twinkle {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wave, .wave :global(.star) { animation: none; }
  }
</style>
