---
/**
 * A Pixel-style phone drawn in CSS 3D, holding real app screens. Thickness comes from stacked slices of the
 * body, so it reads as a solid object at an angle. How far it's turned is the `--turn` custom property (1 is the
 * hero's angle, 0 is flat); the page's script sets it from the scroll position. Several screens can be stacked
 * and the one matching the nearest `[data-active]` shows. A `flat` phone never turns, so it's drawn as one plain
 * layer with no slices: cheap to scroll past on a phone. No 3D library, no extra downloads.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Shot = "today" | "plan" | "calendar" | "rate" | "progress" | "rundetail" | "garmin";
interface Props {
  shots: { shot: Shot; key: string; alt: string }[];
  eager?: boolean;
  flat?: boolean;
  class?: string;
}
const { shots, eager = false, flat = false, class: className = "" } = Astro.props;
const all = import.meta.glob<{ default: ImageMetadata }>("../assets/screens/*/*.png", { eager: true });
const image = (theme: string, shot: Shot) => all[`../assets/screens/${theme}/${shot}.png`].default;
const sizes = "(max-width: 700px) 72vw, 320px";
const slices = Array.from({ length: flat ? 0 : 18 }, (_, i) => i + 1);
---
<div class:list={["device", { flat }, className]}>
  <div class="body">
    {slices.map((i) => <span class="slice" style={`--i: ${i}`} />)}
    {!flat && <span class="keys" aria-hidden="true"><i class="power"></i><i class="volume"></i></span>}
    <div class="front">
      <div class="screen">
        {shots.map(({ shot, key, alt }, n) => (
          <div class="shot" data-key={key}>
            <Image class="light" src={image("light", shot)} alt={alt} widths={[360, 540, 720]} sizes={sizes}
              loading={eager && n === 0 ? "eager" : "lazy"} fetchpriority={eager && n === 0 ? "high" : "auto"} />
            <Image class="dark" src={image("dark", shot)} alt={alt} widths={[360, 540, 720]} sizes={sizes}
              loading={eager && n === 0 ? "eager" : "lazy"} />
          </div>
        ))}
        <span class="camera" aria-hidden="true"></span>
        <span class="sheen" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</div>

<style>
  .device {
    --w: min(300px, 72vw);
    --turn: 0;
    width: var(--w);
    aspect-ratio: 1080 / 2316;
    perspective: 1400px;
  }
  .body {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateY(calc(var(--turn) * -26deg + var(--sway-y, 0deg))) rotateX(calc(var(--turn) * 9deg + var(--sway-x, 0deg))) rotateZ(calc(var(--turn) * 4deg));
    will-change: transform;
  }
  .flat { perspective: none; }
  .flat .body { transform: none; transform-style: flat; will-change: auto; }
  /* The body's thickness: the outline repeated a little deeper each time, darkening towards the back. */
  .slice, .front {
    position: absolute;
    inset: -9px;
    border-radius: 48px;
  }
  .slice {
    background: linear-gradient(90deg, #3a3d42, #1b1c1f 40%, #2c2e33);
    transform: translateZ(calc(var(--i) * -1.2px));
    filter: brightness(calc(1 - var(--i) * 0.024));
  }
  .keys { position: absolute; right: -11px; top: 22%; transform: translateZ(-11px); }
  .keys i { display: block; width: 4px; border-radius: 2px; background: #4a4d53; margin-bottom: 14px; }
  .power { height: 52px; }
  .volume { height: 96px; }
  .front {
    background: #0e0f10;
    box-shadow: inset 0 0 0 1.5px #4b4e55, inset 0 0 0 3px #111;
    padding: 9px;
  }
  .screen { position: relative; width: 100%; height: 100%; border-radius: 39px; overflow: hidden; background: #000; }
  .shot { position: absolute; inset: 0; opacity: 0; transform: scale(1.03);
    transition: opacity 450ms ease, transform 600ms cubic-bezier(.2,.8,.2,1); }
  .shot :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .shot :global(.dark) { display: none; }
  :global(:root[data-theme="dark"]) .shot :global(.light) { display: none; }
  :global(:root[data-theme="dark"]) .shot :global(.dark) { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .shot :global(.light) { display: none; }
    :global(:root:not([data-theme="light"])) .shot :global(.dark) { display: block; }
  }
  .shot.on, .screen:not(:has(.on)) .shot:first-child { opacity: 1; transform: none; }
  .camera { position: absolute; top: 1.6%; left: 50%; width: 3.6%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #2b3a55, #05070a 60%); translate: -50% 0; }
  /* Light catching the glass: slides across as the phone turns. */
  .sheen { position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(115deg, transparent 30%, rgb(255 255 255 / 0.10) 45%, transparent 60%);
    transform: translateX(calc(var(--turn) * 40% - 30%)); }
  @media (prefers-reduced-motion: reduce) { .shot { transition: none; } }
</style>
