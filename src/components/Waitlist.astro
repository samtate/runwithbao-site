---
/** The conversion: an email address, to hear once when Bao is on Google Play. */
import Bao from "./Bao.astro";
---
<form class="waitlist" data-waitlist novalidate>
  <label class="field">
    <span class="sr">Email address</span>
    <input type="email" name="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required />
  </label>
  <button class="button" type="submit" data-cta="waitlist">Tell me when it's out</button>
  <p class="note muted" data-note>One email when Bao lands on Google Play. Nothing else, ever.</p>
  <div class="done" hidden data-done>
    <Bao mood="cheer" size={72} />
    <p><strong>You're on the list.</strong> See you on the start line.</p>
  </div>
</form>

<script>
  import { track } from "../scripts/analytics";
  const form = document.querySelector<HTMLFormElement>("[data-waitlist]")!;
  const note = form.querySelector<HTMLElement>("[data-note]")!;
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const input = form.elements.namedItem("email") as HTMLInputElement;
    const email = input.value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      note.textContent = "That email doesn't look quite right.";
      input.focus();
      return;
    }
    const button = form.querySelector("button")!;
    button.disabled = true;
    const variant = document.querySelector<HTMLElement>("[data-experiment]")?.dataset.shown ?? null;
    try {
      const response = await fetch("https://lctovopzhbrjoywnulat.supabase.co/functions/v1/waitlist", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, variant }),
      });
      if (!response.ok) throw new Error(String(response.status));
      track("waitlist_joined", { variant });
      form.classList.add("joined");
      form.querySelector<HTMLElement>("[data-done]")!.hidden = false;
    } catch {
      note.textContent = "That didn't go through. Try again in a moment.";
      button.disabled = false;
    }
  });
</script>

<style>
  .waitlist { display: grid; grid-template-columns: 1fr auto; gap: 0.75rem; max-width: 34rem; position: relative; }
  .field input {
    width: 100%;
    min-height: 52px;
    padding: 0 1.2rem;
    border-radius: 999px;
    border: 1.5px solid var(--border);
    background: var(--paper);
    color: var(--ink);
    font: 500 1rem var(--sans);
  }
  .field input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 20%, transparent); }
  .note { grid-column: 1 / -1; font-size: 0.92rem; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .done { position: absolute; inset: 0; display: flex; align-items: center; gap: 1rem; background: var(--surface);
    animation: pop 500ms cubic-bezier(.3,1.6,.5,1); }
  .done[hidden] { display: none; }
  .joined > :not(.done) { visibility: hidden; }
  @keyframes pop { from { transform: scale(0.9); opacity: 0; } }
  @media (max-width: 520px) { .waitlist { grid-template-columns: 1fr; } .waitlist .button { justify-content: center; } }
  @media (prefers-reduced-motion: reduce) { .done { animation: none; } }
</style>
