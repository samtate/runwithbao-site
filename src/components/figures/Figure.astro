---
/**
 * The frame every article figure sits in: a card with a short title, the figure, and a caption underneath. Figures
 * are HTML and CSS with real text, so they read aloud, scale with the text size and follow dark mode.
 */
interface Props {
  title?: string;
  caption?: string;
  class?: string;
}
const { title, caption, class: className = "" } = Astro.props;
---
<figure class:list={["fig", className]}>
  {title && <p class="fig-title">{title}</p>}
  <slot />
  {caption && <figcaption set:html={caption} />}
</figure>

<style>
  .fig { margin: 0.5rem 0 1.75rem; padding: clamp(1rem, 3vw, 1.4rem); border-radius: 22px; background: var(--surface);
    border: 1px solid var(--border); display: grid; gap: 0.9rem; font-size: 0.95rem; line-height: 1.45; }
  .fig-title { font: 600 1.15rem/1.25 var(--serif); letter-spacing: -0.01em; margin: 0; }
  figcaption { font-size: 0.875rem; color: var(--muted); }
</style>
