---
/**
 * What a year of each paid app costs in the UK, as bars. Checked against each app's own price page or UK App Store
 * listing in November 2026; the article's table and the pricing page say the same. In pounds on purpose, even for
 * visitors elsewhere: these are the UK prices we checked.
 */
import Figure from "./Figure.astro";

const rows = [
  { name: "Run With Bao Plus", price: 39.99, ours: true },
  { name: "Coopah Pro", price: 79.99 },
  { name: "Runna", price: 109.99 },
  { name: "Strava + Runna", price: 119.99 },
];
const most = 120;
---
<Figure title="A year of each, in the UK"
  caption="Yearly prices as listed in November 2026. Free: Bao's Couch to 5K, Garmin Coach (with a Garmin watch), the NHS Couch to 5K app and Nike Run Club.">
  <ul class="bars">
    {rows.map((r) => (
      <li class:list={{ ours: r.ours }}>
        <span class="name">{r.name}</span>
        <span class="track"><span class="bar" style={`width: ${(r.price / most) * 100}%`}></span></span>
        <span class="value">£{r.price.toFixed(2)}{r.mark}</span>
      </li>
    ))}
  </ul>
</Figure>

<style>
  .bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  li { display: grid; grid-template-columns: minmax(7.5rem, 10rem) 1fr 4.6rem; align-items: center; gap: 0.75rem;
    margin: 0; }
  .name { font-weight: 600; font-size: 0.92rem; }
  .track { height: 1.1rem; }
  .bar { display: block; height: 100%; border-radius: 0 4px 4px 0; background: var(--muted); opacity: 0.55; }
  .ours .bar { background: var(--accent); opacity: 1; }
  .value { font-variant-numeric: tabular-nums; font-weight: 600; text-align: right; }
  @media (max-width: 480px) {
    li { grid-template-columns: 1fr auto; row-gap: 0.25rem; }
    .track { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
