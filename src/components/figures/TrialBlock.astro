---
/**
 * When the time trials fall in a plan, from one of Bao's own test plans (bao-run backend tests/golden/
 * 5k-balanced.txt): the first in week 3 while the paces rest on what the runner told us, then one in the week straight
 * after each lighter week. Bars are each week's running against a normal week; lighter weeks hold three quarters.
 */
import Figure from "./Figure.astro";

const weeks = [1, 2, 3, 4, 5, 6, 7, 8, 9].map((n) => ({
  n,
  lighter: n % 4 === 0,
  trial: n === 3 || n === 9,
}));
---
<Figure title="Time trials in a 5K plan"
  caption="Weeks 1 to 9 of one of Bao's test plans. Lighter weeks hold about three quarters of a normal week's running. The first time trial comes early because, until then, your paces rest on what you told Bao; after that, one follows each lighter week, so your legs are fresh.">
  <ol class="weeks">
    {weeks.map((w) => (
      <li class:list={{ lighter: w.lighter, trial: w.trial }}>
        <span class="flag">{w.trial ? "Time trial" : ""}</span>
        <span class="col"><span class="bar" style={`height: ${w.lighter ? 75 : 100}%`}></span></span>
        <span class="wk">Week {w.n}</span>
        <span class="kind">{w.lighter ? "Lighter" : ""}</span>
      </li>
    ))}
  </ol>
</Figure>

<style>
  .weeks { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(9, 1fr); gap: 6px;
    align-items: end; }
  li { margin: 0; display: grid; grid-template-rows: 2.3rem 7rem auto 1rem; justify-items: center; gap: 0.3rem; }
  .flag { align-self: end; font-size: 0.7rem; font-weight: 700; line-height: 1.1; text-align: center; color: var(--accent-strong); }
  .trial .flag::before { content: ""; display: block; width: 0.9rem; height: 0.9rem; margin: 0 auto 0.2rem; border-radius: 50%;
    border: 2.5px solid var(--accent); box-sizing: border-box; }
  .col { width: 100%; max-width: 2.6rem; height: 100%; display: flex; align-items: flex-end; }
  .bar { width: 100%; border-radius: 4px 4px 0 0; background: var(--sage); }
  .lighter .bar { background: color-mix(in srgb, var(--sage) 45%, var(--surface)); border: 2px solid var(--sage);
    border-bottom: 0; }
  .trial .bar { background: var(--accent); }
  .wk { font-size: 0.72rem; color: var(--muted); white-space: nowrap; }
  .kind { font-size: 0.7rem; font-weight: 600; color: var(--muted); }
  @media (max-width: 520px) { .wk { font-size: 0.62rem; } .flag { font-size: 0.6rem; } li { grid-template-rows: 2.1rem 5.5rem auto 1rem; } }
</style>
