---
/**
 * The training paces a 5K time trial sets, for one example time, as ranges on one pace scale (slower on the left).
 * Worked out with Bao's own pace tables (bao-run backend coach/Fitness.ts, Daniels' VDOT fractions) for a 25:00 5K,
 * before Bao adjusts them to the runner's own runs.
 */
import Figure from "./Figure.astro";

const toSeconds = (t: string) => { const [m, s] = t.split(":").map(Number); return m * 60 + s; };
const slowest = toSeconds("8:00"), quickest = toSeconds("4:30");
const at = (t: string) => ((slowest - toSeconds(t)) / (slowest - quickest)) * 100;
const rows = [
  { name: "Easy", from: "7:36", to: "6:41", note: "Most of your running" },
  { name: "Tempo", from: "5:25", to: "5:16", note: "Comfortably hard" },
  { name: "5K race", from: "5:00", to: "5:00", note: "The time trial itself" },
  { name: "Intervals", from: "4:55", to: "4:45", note: "Short and quick" },
];
---
<Figure title="What a 25:00 5K sets, per kilometre"
  caption="Bao's starting paces for a runner who runs a 5K time trial in 25 minutes. Easy pace is a wide, slow range on purpose. Bao then adjusts them to your own runs and heart rate.">
  <ul class="ladder">
    {rows.map((r) => (
      <li class:list={{ point: r.from === r.to }}>
        <span class="name"><strong>{r.name}</strong><span>{r.note}</span></span>
        <span class="scale">
          <span class="range" style={`left: ${at(r.from)}%; width: ${Math.max(0, at(r.to) - at(r.from))}%`}></span>
        </span>
        <span class="pace">{r.from === r.to ? r.from : `${r.to}–${r.from}`}</span>
      </li>
    ))}
  </ul>
  <p class="axis" aria-hidden="true"><span>Slower · 8:00/km</span><span>4:30/km · Quicker</span></p>
</Figure>

<style>
  .ladder { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  li { margin: 0; display: grid; grid-template-columns: 9rem 1fr 5.6rem; gap: 0.75rem; align-items: center; }
  .name { display: grid; line-height: 1.2; }
  .name span { font-size: 0.78rem; color: var(--muted); }
  .scale { position: relative; height: 1.1rem; border-radius: 4px; background: color-mix(in srgb, var(--ink) 6%, transparent); }
  .range { position: absolute; top: 0; bottom: 0; border-radius: 4px; background: var(--sage); min-width: 0.6rem; }
  .point .range { background: var(--accent); width: 0.75rem !important; margin-left: -0.375rem; border-radius: 50%;
    top: 0.175rem; bottom: 0.175rem; }
  li:nth-child(2) .range, li:nth-child(4) .range { background: var(--butter); }
  .pace { font-variant-numeric: tabular-nums; font-weight: 600; text-align: right; white-space: nowrap; }
  .axis { display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--muted); margin: -0.3rem 0 0;
    padding-left: calc(9rem + 0.75rem); padding-right: calc(5.6rem + 0.75rem); }
  @media (max-width: 560px) {
    li { grid-template-columns: 1fr auto; row-gap: 0.3rem; }
    .scale { grid-column: 1 / -1; grid-row: 2; }
    .axis { padding: 0; }
  }
</style>
