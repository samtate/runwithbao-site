---
/**
 * Light or dark. The page follows the device until someone picks; the pick is remembered on this device only.
 * The sun's rays tuck in and a bite slides across to make a moon, and where the browser can, the new colours
 * spread out from the button in a circle.
 */
---
<button class="toggle" type="button" aria-label="Switch to dark mode" data-theme-toggle>
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
    <mask id="moon-bite">
      <rect x="0" y="0" width="24" height="24" fill="#fff" />
      <circle class="bite" cx="24" cy="4" r="7" fill="#000" />
    </mask>
    <circle class="core" cx="12" cy="12" r="5.5" mask="url(#moon-bite)" fill="currentColor" />
    <g class="rays" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M12 1.5v2.2M12 20.3v2.2M1.5 12h2.2M20.3 12h2.2M4.6 4.6l1.5 1.5M17.9 17.9l1.5 1.5M4.6 19.4l1.5-1.5M17.9 6.1l1.5-1.5" />
    </g>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]")!;
  const system = matchMedia("(prefers-color-scheme: dark)");
  const current = () => root.dataset.theme ?? (system.matches ? "dark" : "light");
  const label = () => {
    const dark = current() === "dark";
    button.dataset.dark = String(dark);
    button.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
  };
  label();
  system.addEventListener("change", label);

  button.addEventListener("click", () => {
    const next = current() === "dark" ? "light" : "dark";
    const apply = () => {
      root.dataset.theme = next;
      try { localStorage.setItem("theme", next); } catch { /* private mode: it just won't be remembered */ }
      label();
    };
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const doc = document as Document & { startViewTransition?: (update: () => void) => { ready: Promise<void> } };
    if (reduced || !doc.startViewTransition) return apply();
    const box = button.getBoundingClientRect();
    const x = box.left + box.width / 2, y = box.top + box.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    doc.startViewTransition(apply).ready.then(() => {
      root.animate({ clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
        { duration: 550, easing: "cubic-bezier(.2,.8,.2,1)", pseudoElement: "::view-transition-new(root)" });
    });
    window.dispatchEvent(new CustomEvent("bao:theme", { detail: next }));
  });
</script>

<style>
  .toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1.5px solid var(--border);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    transition: transform 150ms ease, border-color 150ms ease;
  }
  .toggle:hover { border-color: var(--ink); }
  .toggle:active { transform: scale(0.9); }
  svg { overflow: visible; }
  .core { transform-origin: center; transition: r 400ms cubic-bezier(.3,1.6,.5,1); }
  .bite { transition: cx 450ms cubic-bezier(.3,1.4,.5,1), cy 450ms cubic-bezier(.3,1.4,.5,1); }
  .rays { transform-origin: 12px 12px; transition: transform 450ms cubic-bezier(.3,1.4,.5,1), opacity 250ms ease; }
  .toggle[data-dark="true"] .core { r: 9px; }
  .toggle[data-dark="true"] .bite { cx: 17px; cy: 7px; }
  .toggle[data-dark="true"] .rays { transform: rotate(-60deg) scale(0.4); opacity: 0; }
  @media (prefers-reduced-motion: reduce) {
    .core, .bite, .rays { transition: none; }
  }
  :global(::view-transition-old(root)), :global(::view-transition-new(root)) { animation: none; mix-blend-mode: normal; }
</style>
