---
/**
 * How a rating changes the plan: a tap on the scale, then next week's runs grow (it felt easy) or shrink (it
 * felt hard), in turn. Loops while on screen.
 */
const runs = [["Tue", 48], ["Thu", 40], ["Sat", 30], ["Sun", 62]];
---
<div class="adapt" data-reveal data-loop role="img"
  aria-label="After a run rated 3 out of 10, next week steps up a little; after one rated 8, it eases off.">
  <p class="label">How did that feel?</p>
  <div class="scale">
    {Array.from({ length: 10 }, (_, i) => <span class:list={["n", `n${i + 1}`]} style={`--k: ${i}`}>{i + 1}</span>)}
    <span class="aim" aria-hidden="true"><i class="finger"></i></span>
  </div>
  <div class="next">
    <p class="label">Next week</p>
    <p class="verdict"><span class="up">A step up</span><span class="down">An easier week</span></p>
    <div class="bars">
      {runs.map(([d, m], i) => (
        <span class="col"><span class="bar" style={`--m: ${m}; --i: ${i}`}></span><small>{d}</small></span>
      ))}
    </div>
  </div>
</div>

<style>
  .adapt { background: var(--surface); border: 1px solid var(--border); border-radius: 24px; padding: 1.1rem 1.2rem 1.2rem;
    display: grid; gap: 0.8rem; max-width: 30rem; }
  .scale { position: relative; display: grid; grid-template-columns: repeat(10, 1fr); gap: 4px; }
  .n { aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%; font: 600 0.8rem/1 var(--sans);
    background: color-mix(in srgb, color-mix(in oklab, var(--sage), var(--accent) calc(var(--k) * 11%)) 26%, transparent); }
  /* The finger rides a layer the scale's width, so it moves by transform rather than by left. */
  .aim { position: absolute; inset: 0; pointer-events: none; }
  .finger { position: absolute; top: 58%; left: 0; width: 22px; height: 22px; border-radius: 50% 50% 50% 0;
    background: var(--ink); border: 3px solid var(--surface); opacity: 0; }
  .n { position: relative; }
  .n::after { content: ""; position: absolute; inset: 0; border-radius: 50%; border: 2px solid currentColor; opacity: 0; }
  .next { border-top: 1px solid var(--border); padding-top: 0.8rem; display: grid; gap: 0.4rem; }
  .verdict { position: relative; height: 1.6rem; font: 600 1.2rem/1.3 var(--serif); }
  .verdict span { position: absolute; inset: 0; opacity: 0; }
  .bars { display: flex; align-items: flex-end; gap: 10px; height: 92px; }
  .col { flex: 1; display: grid; justify-items: center; gap: 0.25rem; align-content: end; height: 100%; }
  .bar { width: min(100%, 52px); height: calc(var(--m) * 1.2px); border-radius: 8px 8px 4px 4px; background: var(--sage);
    transform-origin: bottom; }
  .col small { font-size: 0.75rem; color: var(--muted); }

  /* One 8s loop. The finger drifts in and taps 3: the number pops with a ripple, "A step up" rises, and next
     week's runs grow one after another. It glides on to 8: the same, and the week eases off, bars softening to the
     easy colour. Then everything relaxes back before the loop comes round. */
  .adapt:global(.in) .aim { animation: aim 8s cubic-bezier(.6,0,.3,1) infinite; }
  .adapt:global(.in) .finger { animation: tap 8s ease infinite; }
  .adapt:global(.in) .n3 { animation: pick3 8s ease infinite; }
  .adapt:global(.in) .n8 { animation: pick8 8s ease infinite; }
  .adapt:global(.in) .n3::after { animation: ripple3 8s ease-out infinite; }
  .adapt:global(.in) .n8::after { animation: ripple8 8s ease-out infinite; }
  .adapt:global(.in) .up { animation: show-up 8s cubic-bezier(.2,.8,.2,1) infinite; }
  .adapt:global(.in) .down { animation: show-down 8s cubic-bezier(.2,.8,.2,1) infinite; }
  .adapt:global(.in) .bar { animation: size 8s infinite; animation-delay: calc(var(--i) * 70ms); }
  @keyframes aim {
    0%, 8% { transform: translateX(calc(25% - 4px)); } 46% { transform: translateX(calc(25% - 4px)); }
    56%, 100% { transform: translateX(calc(75% - 4px)); }
  }
  @keyframes tap {
    0% { opacity: 0; transform: translate(14px, 18px); } 8% { opacity: 1; transform: none; }
    12% { transform: scale(0.82); } 15%, 56% { transform: none; } 59% { transform: scale(0.82); } 62% { transform: none; }
    88% { opacity: 1; transform: none; } 95%, 100% { opacity: 0; transform: translate(14px, 18px); }
  }
  @keyframes pick3 {
    0%, 11% { transform: none; }
    13% { transform: scale(1.22); background: var(--sage); color: #1b2a1d; }
    18%, 46% { transform: none; background: var(--sage); color: #1b2a1d; }
    52%, 100% { transform: none; }
  }
  @keyframes pick8 {
    0%, 58% { transform: none; }
    60% { transform: scale(1.22); background: var(--accent); color: #fff; }
    65%, 90% { transform: none; background: var(--accent); color: #fff; }
    97%, 100% { transform: none; }
  }
  @keyframes ripple3 { 0%, 12% { opacity: 0; transform: scale(1); } 13% { opacity: 0.6; } 24%, 100% { opacity: 0; transform: scale(1.7); } }
  @keyframes ripple8 { 0%, 59% { opacity: 0; transform: scale(1); } 60% { opacity: 0.6; } 71%, 100% { opacity: 0; transform: scale(1.7); } }
  @keyframes show-up { 0%, 15% { opacity: 0; transform: translateY(8px); } 21%, 46% { opacity: 1; transform: none; } 51%, 100% { opacity: 0; transform: translateY(-8px); } }
  @keyframes show-down { 0%, 62% { opacity: 0; transform: translateY(8px); } 68%, 90% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; transform: translateY(-8px); } }
  @keyframes size {
    0%, 17% { transform: scaleY(1); background: var(--sage); animation-timing-function: cubic-bezier(.3,1.5,.5,1); }
    27%, 50% { transform: scaleY(1.16); background: var(--sage); animation-timing-function: ease-in-out; }
    56% { transform: scaleY(1); }
    63% { transform: scaleY(1); background: var(--sage); animation-timing-function: cubic-bezier(.3,1.4,.5,1); }
    73%, 90% { transform: scaleY(0.78); background: var(--walk); animation-timing-function: ease-in-out; }
    100% { transform: scaleY(1); background: var(--sage); }
  }
  @media (prefers-reduced-motion: reduce) {
    .adapt:global(.in) * { animation: none !important; }
    .up { opacity: 1; } .n3 { background: var(--sage); }
  }
</style>
