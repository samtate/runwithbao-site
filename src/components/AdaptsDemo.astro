---
/**
 * How a rating changes the plan: a tap on the scale, then next week's runs grow (it felt easy) or shrink (it
 * felt hard), in turn. Loops while on screen.
 */
const runs = [["Tue", 48], ["Thu", 40], ["Sat", 30], ["Sun", 62]];
---
<div class="adapt" data-reveal role="img"
  aria-label="After a run rated 3 out of 10, next week steps up a little; after one rated 8, it eases off.">
  <p class="label">How did that feel?</p>
  <div class="scale">
    {Array.from({ length: 10 }, (_, i) => <span class:list={["n", `n${i + 1}`]} style={`--k: ${i}`}>{i + 1}</span>)}
    <i class="finger" aria-hidden="true"></i>
  </div>
  <div class="next">
    <p class="label">Next week</p>
    <p class="verdict"><span class="up">A step up</span><span class="down">An easier week</span></p>
    <div class="bars">
      {runs.map(([d, m]) => (
        <span class="col"><span class="bar" style={`--m: ${m}`}></span><small>{d}</small></span>
      ))}
    </div>
  </div>
</div>

<style>
  .adapt { background: var(--surface); border: 1px solid var(--border); border-radius: 24px; padding: 1.1rem 1.2rem 1.2rem;
    display: grid; gap: 0.8rem; max-width: 30rem; }
  .scale { position: relative; display: grid; grid-template-columns: repeat(10, 1fr); gap: 4px; }
  .n { aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%; font: 600 0.8rem/1 var(--sans);
    background: color-mix(in srgb, color-mix(in oklab, var(--sage), var(--accent) calc(var(--k) * 11%)) 26%, transparent); }
  .finger { position: absolute; top: 60%; width: 22px; height: 22px; border-radius: 50% 50% 50% 0; background: var(--ink);
    border: 3px solid var(--surface); opacity: 0; }
  .next { border-top: 1px solid var(--border); padding-top: 0.8rem; display: grid; gap: 0.4rem; }
  .verdict { position: relative; height: 1.6rem; font: 600 1.2rem/1.3 var(--serif); }
  .verdict span { position: absolute; inset: 0; opacity: 0; }
  .bars { display: flex; align-items: flex-end; gap: 10px; height: 92px; }
  .col { flex: 1; display: grid; justify-items: center; gap: 0.25rem; align-content: end; height: 100%; }
  .bar { width: min(100%, 52px); height: calc(var(--m) * 1.2px); border-radius: 8px 8px 4px 4px; background: var(--sage);
    transform-origin: bottom; }
  .col small { font-size: 0.75rem; color: var(--muted); }

  /* First half: a 3, and the week grows. Second half: an 8, and it shrinks. */
  .adapt:global(.in) .finger { animation: tap 7s ease infinite; }
  .adapt:global(.in) .n3 { animation: pick3 7s ease infinite; }
  .adapt:global(.in) .n8 { animation: pick8 7s ease infinite; }
  .adapt:global(.in) .up { animation: show-up 7s ease infinite; }
  .adapt:global(.in) .down { animation: show-down 7s ease infinite; }
  .adapt:global(.in) .bar { animation: size 7s cubic-bezier(.3,1.4,.5,1) infinite; }
  @keyframes tap {
    0% { left: 5%; opacity: 0; } 8% { left: 21%; opacity: 1; } 14% { left: 21%; transform: scale(0.85); }
    18% { transform: none; } 40% { left: 21%; opacity: 1; } 52% { left: 72%; opacity: 1; } 58% { transform: scale(0.85); }
    62% { transform: none; } 88% { left: 72%; opacity: 1; } 96%, 100% { opacity: 0; }
  }
  @keyframes pick3 { 0%, 13% { background: color-mix(in srgb, var(--sage) 26%, transparent); color: inherit; }
    15%, 46% { background: var(--sage); color: #1b2a1d; } 50%, 100% { background: color-mix(in srgb, var(--sage) 26%, transparent); } }
  @keyframes pick8 { 0%, 57% { background: color-mix(in srgb, var(--accent) 26%, transparent); color: var(--ink); }
    59%, 94% { background: var(--accent); color: #fff; }
    98%, 100% { background: color-mix(in srgb, var(--accent) 26%, transparent); color: var(--ink); } }
  @keyframes show-up { 0%, 16% { opacity: 0; transform: translateY(6px); } 22%, 46% { opacity: 1; transform: none; } 50%, 100% { opacity: 0; } }
  @keyframes show-down { 0%, 60% { opacity: 0; transform: translateY(6px); } 66%, 92% { opacity: 1; transform: none; } 97%, 100% { opacity: 0; } }
  @keyframes size {
    0%, 16% { transform: scaleY(1); background: var(--sage); } 26%, 48% { transform: scaleY(1.12); background: var(--sage); }
    60% { transform: scaleY(1.12); } 70%, 92% { transform: scaleY(0.8); background: var(--walk); } 100% { transform: scaleY(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .adapt:global(.in) * { animation: none !important; }
    .up { opacity: 1; } .n3 { background: var(--sage); }
  }
</style>
