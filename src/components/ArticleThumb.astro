---
/**
 * An article's illustration as a small picture, for lists of articles: the light and dark renders that
 * scripts/build-share.mjs makes, resized and lazy-loaded, with the one for the current theme shown.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props { slug: string; sizes: string; eager?: boolean }
const { slug, sizes, eager = false } = Astro.props;
const all = import.meta.glob<{ default: ImageMetadata }>("../assets/art/*.png", { eager: true });
const light = all[`../assets/art/${slug}-light.png`]?.default;
const dark = all[`../assets/art/${slug}-dark.png`]?.default;
const widths = [320, 480, 720];
---
{light && dark && (
  <span class="thumb">
    <Image class="light" src={light} alt="" widths={widths} sizes={sizes} loading={eager ? "eager" : "lazy"} />
    <Image class="dark" src={dark} alt="" widths={widths} sizes={sizes} loading="lazy" />
  </span>
)}

<style>
  .thumb { display: block; border-radius: 18px; overflow: hidden; aspect-ratio: 2 / 1; background: var(--border); }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .thumb :global(.dark) { display: none; }
  :global(:root[data-theme="dark"]) .thumb :global(.light) { display: none; }
  :global(:root[data-theme="dark"]) .thumb :global(.dark) { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .thumb :global(.light) { display: none; }
    :global(:root:not([data-theme="light"])) .thumb :global(.dark) { display: block; }
  }
</style>
